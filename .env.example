# Copy this file to .env and fill in your existing Firebase project's web config.
# (Project Settings -> General -> Your apps -> SDK setup and configuration)
#
# If these are left blank, the app runs in local/demo mode: uploaded CSVs are
# stored in the browser's localStorage instead of Firestore, and the admin
# upload page is open (no sign-in required). This lets you try the module
# before wiring it into the real project's Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
